# Optional local database override. Omit this variable to use the default
# repository-local SQLite database at data/nfl_model.db.
# DATABASE_URL=sqlite:///./nfl_model.db

# Optional: required for live NFL, MLB, and CFB market imports.
ODDS_API_KEY=

# Optional: required for College Football Data API FBS schedule imports.
CFBD_API_KEY=

# Optional: set this in frontend/.env.local only when the FastAPI server is
# not running at http://127.0.0.1:8000.
# VITE_API_URL=http://127.0.0.1:8000
